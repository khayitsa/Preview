# Copy to .env for Docker; otherwise export in your process manager.
# Set your actual HTTPS origin before inviting teammates.
FEFFEL_PUBLIC_URL=https://feffel.your-domain.example
FEFFEL_SECURE_COOKIES=1
FEFFEL_MAX_UPLOAD_MB=100
# For non-Docker hosting, point this at a persistent, private directory:
# FEFFEL_DATA_DIR=/srv/feffel-data
# Optional SMTP. Run `flask --app wsgi send-mail` periodically to deliver the outbox.
# FEFFEL_SMTP_HOST=smtp.your-provider.example
# FEFFEL_SMTP_PORT=587
# FEFFEL_SMTP_FROM=Feffel <notifications@your-domain.example>
# FEFFEL_SMTP_USER=
# FEFFEL_SMTP_PASSWORD=
