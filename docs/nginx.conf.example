# Replace the hostname and certificate paths. TLS certificates are supplied by Keith.
server {
    listen 443 ssl;
    server_name feffel.your-domain.example;
    ssl_certificate /etc/letsencrypt/live/feffel.your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/feffel.your-domain.example/privkey.pem;
    client_max_body_size 105m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }
}
server {
    listen 80;
    server_name feffel.your-domain.example;
    return 301 https://$host$request_uri;
}
